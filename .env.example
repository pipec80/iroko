# ─────────────────────────────────────────────
# Supabase (required)
# ─────────────────────────────────────────────

# Public URL of your Supabase project (client + server)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable (anon) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon-key>

# Service-role secret key — server-side only, never expose to the client
SUPABASE_SECRET_KEY=<service-role-key>

# ─────────────────────────────────────────────
# App (optional — defaults shown)
# ─────────────────────────────────────────────

# Canonical URL used in sitemap and canonical tags (default: http://localhost:3000)
SITE_URL=https://yourdomain.com

# Pino log level: fatal | error | warn | info | debug | trace | silent (default: info)
# LOG_LEVEL=info

# ─────────────────────────────────────────────
# Sentry (optional)
# ─────────────────────────────────────────────

# DSN for error tracking (client + server). Omit to disable Sentry.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# Auth token for source-map upload during `next build` (CI only)
# SENTRY_AUTH_TOKEN=<token>

# ─────────────────────────────────────────────
# PostHog (optional — product analytics, opt-out by default)
# ─────────────────────────────────────────────

# Project API key (starts with phc_). Omit to disable analytics entirely
# (the SDK never initializes without it — see src/lib/analytics/client.ts).
# From https://us.posthog.com/project/<id>/settings/project
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_<your-project-token>

# Same-origin reverse proxy path (default: /ingest). Do not point this at
# the raw PostHog host — the rewrites in next.config.ts keep events first-party.
# NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Real ingest host used only by the server-side posthog-node client
# (the /ingest proxy path only resolves inside a browser request).
# POSTHOG_HOST=https://us.i.posthog.com

# ─────────────────────────────────────────────
# Google OAuth (enabled by default in supabase/config.toml)
# ─────────────────────────────────────────────

# [auth.external.google] is `enabled = true` out of the box — without these,
# "Sign in with Google" fails at `supabase start`. Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials, redirect URI
# http://127.0.0.1:54321/auth/v1/callback.
GOOGLE_CLIENT_ID=<google-oauth-client-id>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<google-oauth-client-secret>

# ─────────────────────────────────────────────
# Cloudflare Turnstile CAPTCHA (optional)
# ─────────────────────────────────────────────

# Site key shown on auth forms. Pair with [auth.captcha] in supabase/config.toml.
# Local always-pass test key: 1x00000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site-key>

# ─────────────────────────────────────────────
# CI only
# ─────────────────────────────────────────────

# Set to 1 in Dependabot PRs (no secrets available) to skip env validation during build
# SKIP_ENV_VALIDATION=1

# ─────────────────────────────────────────────
# Email — Resend (required for transactional email)
# ─────────────────────────────────────────────

# API key from resend.com (free tier: 3 000 emails/month)
# In local dev, Resend sends real emails — use your own address for testing.
# Supabase Auth emails (signup confirm, magic link) go through Inbucket at http://127.0.0.1:54324
RESEND_API_KEY=re_<your-api-key>

# "From" address for transactional emails — must be a verified domain in Resend
FROM_EMAIL=noreply@yourdomain.com
# Billing (F2-2A-core) — mock provider, sin credenciales de proveedor real aún
MOCK_BILLING_SECRET=dev-mock-secret-change-me
BILLING_DEFAULT_PROVIDER=mock
# Stripe (optional — omit to keep only MockProvider active). Test mode keys
# from https://dashboard.stripe.com/test/apikeys. Webhook secret comes from
# `stripe listen` locally, or the Dashboard's webhook endpoint config in prod.
STRIPE_SECRET_KEY=mock
STRIPE_WEBHOOK_SECRET=mock

# MercadoPago (optional — omit to keep only MockProvider active). Test access
# token from your application's "Test credentials" tab. Webhook secret from
# Webhooks → Configure notifications.
MERCADOPAGO_ACCESS_TOKEN=mock
MERCADOPAGO_WEBHOOK_SECRET=mock
