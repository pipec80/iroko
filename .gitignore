/.agent/
/.agents/
/.gemini/
/.codex/
/.cursor/
/.opencode/
/.zed/
/.vscode/
/.claude/
# .github tracked: workflows, templates, dependabot, CODEOWNERS must be in git
/.temp/
/.kiro/
/.scratch/
.mcp.json

# supabase local runtime (no commitear)
supabase/.temp/
supabase/.branches/
supabase/functions/temp-func/

# documentación local, privada o generada (NUNCA commitear)
docs/info.txt
/docs/local/
/docs/private/
/docs/drafts/
/docs/generated/
/docs/exports/
docs/**/*.local.md
docs/**/*.private.md
docs/**/*.draft.md
docs/**/*.pdf

# docs/index.md § Directory policy: audits/, exec-plans/, runbooks/, quality/,
# prompts/, architecture/, adr/, modules/, design-system/ y las evidencias
# allowlisted son públicas. El resto del material local vive en /docs/local/
# (reordenado 2026-08-19: audit/, codx-docs/, database/, intercon/, nextjs/ y
# plans/ ya no son entradas propias — su contenido se consolidó dentro de
# local/, que ya cubre el árbol completo con una sola regla).
/docs/estado-fases.md
/.superpowers/

# scratch / herramientas locales (no pertenecen al repo)
/scratch/
nuevo4.txt
data-local.txt
knip-output.txt
skills-lock.json
.antigravitycli/
cspell.json

# supabase studio queries locales
supabase/snippets/

